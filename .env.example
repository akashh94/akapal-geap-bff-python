# Port the BFF listens on (the portal's BFF_URL targets this).
PORT=4000

# Must be the SAME value as the chat-portal's SESSION_SECRET so the BFF can
# verify the portal's session JWT and recover the logged-in user id.
SESSION_SECRET=change-me-to-the-same-value-as-the-portal

# Persistence for the user_id -> agent session_id mapping.
DATABASE_PATH=./data/bff.db

# Agent Engine (Vertex AI Reasoning Engine) target. Default is the
# akapal-geap-agents ADK agent in the personal project. Requires Application
# Default Credentials with access to that project.
GEAP_ENGINE_PROJECT=adk-tut-508714
GEAP_ENGINE_LOCATION=us-central1
GEAP_ENGINE_ID=335803495506509824
